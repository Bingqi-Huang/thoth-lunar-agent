# Manuscript figure style, read off figures/fig4_platform.pdf and figures/fig_authority_timeline.pdf
# (sources: <local figure sources>). Units: the sources are drawn in CSS px
# (1 px = 0.75 pt) at 657 px = 173.8 mm = 6.843 in text width, so every pt value below is source px * 0.75.
# Draw figures at their true print size (style.PAGE_W / style.COLUMN_W) and the text stays at these sizes.
# Colours are written without '#' because '#' starts a comment in style files.

# --- fonts: Inter (as in both source PDFs; Inter-Regular, Inter-SemiBold embedded) -------------------------
# style.use() registers the Inter TTFs from ~/.local/share/fonts; without them the stack falls back as the
# sources' own CSS stack does (Inter, Liberation Sans, Arial, sans-serif).
font.family:            sans-serif
font.sans-serif:        Inter, Liberation Sans, Arial, DejaVu Sans
font.monospace:         JetBrains Mono, DejaVu Sans Mono
font.size:              6.6        # 8.8 px: annotations, ticks, legend, notes (Tf 8.8 in the timeline PDF)
axes.titlesize:         7.8        # 10.4 px: panel head, fig4 (a)..(e)
axes.labelsize:         6.6        # 8.8 px: "mission time (s)"
xtick.labelsize:        6.6
ytick.labelsize:        6.6
legend.fontsize:        6.6
legend.title_fontsize:  6.6
figure.titlesize:       7.8
figure.labelsize:       6.6
font.weight:            normal     # Inter Regular; emphasis is SemiBold (weight 600 / 'semibold'), never Bold
axes.titleweight:       normal
axes.labelweight:       normal
mathtext.fontset:       stix       # the paper sets maths in STIX (common.js F.math)
mathtext.default:       regular

# --- text colours ---------------------------------------------------------------------------------------
text.color:             1D2329     # ink
axes.labelcolor:        7B848D     # muted: axis title in the timeline
xtick.labelcolor:       4A535C     # sub: tick labels in the timeline
ytick.labelcolor:       4A535C
xtick.color:            7B848D     # tick marks: muted
ytick.color:            7B848D

# --- axes, spines, ticks (timeline: x axis only, rule-grey 0.7 px, ticks 3 px muted 0.7 px) ------------------
axes.facecolor:         FFFFFF
axes.edgecolor:         C7CDD3     # rule
axes.linewidth:         0.525      # 0.7 px
axes.spines.top:        False
axes.spines.right:      False
axes.titlelocation:     left       # panel head sits flush with the panel's left edge
axes.titlepad:          5.25       # baseline 7 px above the panel top (fig4: head baseline y=12, panel top y=19)
axes.labelpad:          2.5
axes.axisbelow:         True
axes.xmargin:           0.02
axes.ymargin:           0.0
xtick.direction:        out
ytick.direction:        out
xtick.major.size:       2.25       # 3 px
ytick.major.size:       2.25
xtick.major.width:      0.525      # 0.7 px
ytick.major.width:      0.525
xtick.major.pad:        2.5        # digits' baseline 13 px below the axis, tick 3 px
ytick.major.pad:        2.5
xtick.minor.visible:    False
ytick.minor.visible:    False

# --- grid: hairline lanes, #E3E7EB 0.8 px (timeline lanes); horizontal only ------------------------------------
axes.grid:              True
axes.grid.axis:         y
grid.color:             E3E7EB     # hair
grid.linewidth:         0.6        # 0.8 px
grid.linestyle:         -

# --- lines, markers, patches -------------------------------------------------------------------------------
lines.linewidth:        0.9        # 1.2 px: timeline baseline (1.2), arrows 1.1, pole arrow 1.3
lines.solid_capstyle:   round
lines.markersize:       4.5        # diamond r = 4.6 px in the timeline
lines.markeredgewidth:  0.675      # 0.9 px white outline round markers
lines.markeredgecolor:  FFFFFF
patch.linewidth:        0.6        # 0.8 px (outlined pills, tinted rects)
patch.force_edgecolor:  False
hatch.linewidth:        0.675      # 0.9 px (hatch pattern stroke, gap 3.4 px; '///' is the closest density)
hatch.color:            C7CDD3
errorbar.capsize:       2.0
axes.prop_cycle:        cycler('color', ['2E5E80', '9FC0D9', '1B3344', 'B06F3C', '7A736B'])

# --- legend: borderless, swatches 12 x 10 px, 5 px gap to the label, 16 px between items -----------------
legend.frameon:         False
legend.handlelength:    1.36       # 12 px / 8.8 px
legend.handleheight:    1.14       # 10 px / 8.8 px
legend.handletextpad:   0.57       # 5 px / 8.8 px
legend.columnspacing:   1.82       # 16 px / 8.8 px
legend.borderaxespad:   0.0
legend.labelcolor:      4A535C     # sub

# --- figure, output --------------------------------------------------------------------------------------------
figure.facecolor:       FFFFFF
figure.dpi:             200
figure.constrained_layout.use: True
figure.constrained_layout.h_pad: 0.03
figure.constrained_layout.w_pad: 0.03
figure.constrained_layout.hspace: 0.04
figure.constrained_layout.wspace: 0.04
savefig.dpi:            384        # the sources' PNGs are 4x at 96 dpi
savefig.facecolor:      FFFFFF
savefig.transparent:    False
savefig.bbox:           standard   # keep the exact print size; tight cropping would change the scale in LaTeX
pdf.fonttype:           42         # embed TrueType (Type 42), as the sources embed Inter
ps.fonttype:            42
svg.fonttype:           none
pdf.compression:        6
